# 中央服务监听与认证
MEMORY_LISTEN_ADDRESS=:8080
MEMORY_DATABASE_URL=
MEMORY_API_TOKEN=
MEMORY_API_TOKEN_FILE=
MEMORY_SIGNAL_HMAC_SECRET=

# 本地 stdio MCP bridge 连接中央服务
MEMORY_API_URL=https://memory-recall-coin.example.ts.net
MEMORY_DEFAULT_NAMESPACE=memory-recall-coin
MEMORY_WORKSPACE_CODE=github.com/Alhamdulillah-R/memory-recall-coin
MEMORY_DEFAULT_SCOPE=workspace
MEMORY_IDENTITY_FILE=
MEMORY_AUTO_REGISTER=true

# OpenAI-compatible embedding；none 会关闭 semantic channel
MEMORY_EMBEDDING_PROVIDER=none
MEMORY_EMBEDDING_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_QUERY_INSTRUCTION=
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_WORKERS=2
MEMORY_EMBEDDING_BATCH_SIZE=32

# Ingestion、HTTP 与生命周期限制
MEMORY_MAX_FILE_BYTES=2097152
MEMORY_MAX_RPC_BODY_BYTES=33554432
MEMORY_CHUNK_CHARACTERS=1800
MEMORY_CHUNK_OVERLAP_CHARACTERS=200
MEMORY_WATCH_DEBOUNCE=750ms
MEMORY_REQUEST_TIMEOUT=30s
MEMORY_SHUTDOWN_TIMEOUT=15s
